DISCORD_TOKEN=put-your-bot-token-here

# Optional: set this while developing so slash commands update immediately in one server.
# Leave it blank for global command sync.
DEV_GUILD_ID=

# Optional: force one text channel to be used for message-based music requests.
# Usually you can leave this blank and run /setupmusic in Discord instead.
MUSIC_CHANNEL_ID=

# Optional: channel name created by /setupmusic when no existing channel is selected.
MUSIC_CHANNEL_NAME=music

# Optional: send bot replies in the music request channel as silent Discord messages.
MUSIC_CHANNEL_SILENT=true

# Optional: delete a user's song request message after it is queued successfully.
MUSIC_CHANNEL_DELETE_REQUESTS=true

# Optional: delete temporary queue-added feedback messages after this many seconds.
MUSIC_FEEDBACK_DELETE_SECONDS=10

# Optional: delete ordinary private interaction responses after this many seconds.
EPHEMERAL_RESPONSE_DELETE_SECONDS=15

# Optional: delete a private queue UI this many seconds after its latest deletion.
QUEUE_DELETE_RESPONSE_DELETE_SECONDS=30

# Optional: original-language lyrics lookup through LRCLIB.
LYRICS_API_URL=https://lrclib.net/api/search
LYRICS_REQUEST_TIMEOUT_SECONDS=10

# Optional: if LRCLIB has no result, use manual YouTube subtitles when available.
# Automatically generated and auto-translated captions are never used.
YOUTUBE_LYRICS_FALLBACK=true

# Optional: read source, Korean reading, and Korean translation groups from NamuWiki.
# Without an API token, the bot reads the public page at a conservative interval.
# An account with api_access can use the official source API instead.
NAMUWIKI_LYRICS_ENABLED=true
NAMUWIKI_PAGE_BASE_URL=https://namu.wiki/w
NAMUWIKI_API_BASE_URL=https://wiki-api.namu.la/api
# NAMUWIKI_API_TOKEN=
# Retry blocked public pages through NamuWiki's Discord link-preview renderer.
NAMUWIKI_PREVIEW_FALLBACK_ENABLED=true
NAMUWIKI_REQUEST_TIMEOUT_SECONDS=10
NAMUWIKI_REQUEST_INTERVAL_SECONDS=1.1

# Optional: map a YouTube video ID or normalized song key to an exact document.
# Keep this as a one-line JSON object.
# NAMUWIKI_DOCUMENT_OVERRIDES={"video:abcdefghijk":"泥濘鳴鳴"}

# Optional: cookies for content that requires a signed-in account.
# Cookies do not remove rate limits; never commit this file or use a primary account.
# YOUTUBE_COOKIES_FILE=./cookies.txt

# Optional: yt-dlp timeout, concurrency, background/search spacing, and in-memory cache.
# The stream needed for immediate playback skips this spacing.
YTDL_EXTRACT_TIMEOUT_SECONDS=45
YTDL_MAX_CONCURRENT_EXTRACTIONS=1
YTDL_MIN_INTERVAL_SECONDS=6
YOUTUBE_SUBTITLE_MIN_INTERVAL_SECONDS=6
YTDL_CACHE_TTL_SECONDS=180
YTDL_CACHE_MAX_ENTRIES=16

# Optional: stagger noncritical work after playback starts to reduce CPU spikes.
AUTOPLAY_START_DELAY_SECONDS=10
LYRICS_START_DELAY_SECONDS=3

# Optional: flat search results compared before resolving one playable video (maximum 20).
YOUTUBE_SEARCH_CANDIDATES=10

# Optional: search the YouTube Music catalog before falling back to regular YouTube.
YOUTUBE_MUSIC_SEARCH_ENABLED=true
YOUTUBE_MUSIC_MIN_INTERVAL_SECONDS=1
YOUTUBE_MUSIC_SEARCH_TIMEOUT_SECONDS=5
YOUTUBE_MUSIC_LANGUAGE=en
# YOUTUBE_MUSIC_LOCATION=KR

# Optional: ytmusicapi browser or OAuth token JSON. Never commit this file.
# YOUTUBE_MUSIC_AUTH_FILE=./ytmusic-auth.json
# OAuth token files also require the same client credentials used to create them.
# YOUTUBE_MUSIC_OAUTH_CLIENT_ID=
# YOUTUBE_MUSIC_OAUTH_CLIENT_SECRET=

# Optional: stop all new YouTube requests for this many seconds after a 429/bot check.
YOUTUBE_CIRCUIT_BREAKER_SECONDS=1800

# Optional: refresh a queued signed stream URL after this many seconds.
STREAM_URL_MAX_AGE_SECONDS=900

# Optional: maximum number of tracks added from an album or playlist at once.
MAX_BULK_TRACKS=50

# Optional: default and maximum number of related tracks added by auto:.
DEFAULT_AUTO_TRACKS=8
MAX_AUTO_TRACKS=25
# Background refill inspects this many results from one candidate list; direct autoN: requests are unchanged.
AUTOPLAY_REFILL_CANDIDATES=10
# Recently played tracks are excluded from autoplay for this many seconds.
AUTOPLAY_HISTORY_TTL_SECONDS=43200

# Optional: use this if ffmpeg is not on PATH.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
